# David injects OPENAI_API_KEY into deployed Preview and Production runtimes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Add a TypeSafe Jev key to activate the live decision layer.
JEV_API_KEY=
JEV_MODEL=jev-latest

# Server-only credentials for real restaurant search and Google Maps activity.
GOOGLE_MAPS_API_KEY=
APIFY_TOKEN=

NEXT_PUBLIC_SITE_URL=https://example.com
