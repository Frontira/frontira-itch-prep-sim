{
  "name": "itch-prep-sim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node -e \"require('fs').existsSync('node_modules')||(console.error('\\n\\u25b2 node_modules missing — run pnpm install first.\\n'),process.exit(1))\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "biome check",
    "format": "biome format --write",
    "test:visual": "playwright test tests/visual-acceptance.spec.ts",
    "check:design-system": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
